{
  "name": "mailstudio",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "node scripts/copy-pdf-assets.mjs && vite",
    "build": "node scripts/copy-pdf-assets.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "tauri": "tauri",
    "release": "node scripts/release.mjs",
    "check:version": "node scripts/release.mjs --check",
    "bridge": "cargo run -p mailstudio --bin mailstudio-bridge --features dev-bridge",
    "mailserver": "python scripts/dev-mail-server.py"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide-react": "^1.72.0",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
